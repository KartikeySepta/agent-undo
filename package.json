{
  "name": "agent-undo",
  "version": "1.2.0",
  "description": "Ultra-fast, instantaneous filesystem snapshots for AI coding agents. The Time Machine for AI.",
  "main": "bin/core.cjs",
  "bin": {
    "agent-undo": "bin/agent-undo.cjs",
    "agent-undo-mcp": "bin/agent-undo-mcp.cjs"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.js",
    "prepack": "npm run build",
    "version": "node scripts/sync-version.js && npm run build && git add .claude-plugin/plugin.json .codex-plugin/plugin.json gemini-extension.json src/version.ts bin",
    "bench": "node benchmarks/clone.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^12.0.0",
    "ignore": "^7.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  },
  "keywords": [
    "ai",
    "agent",
    "mcp",
    "undo",
    "snapshot",
    "rollback"
  ],
  "author": {
    "name": "Kartikey Septa",
    "url": "https://github.com/KartikeySepta"
  },
  "license": "MIT",
  "files": [
    "bin",
    "hooks",
    "skills",
    "scripts/cursor-hooks.js",
    ".opencode/plugins",
    "AGENTS.md",
    "INSTALL.md",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "koffi": "^3.3.2"
  },
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://github.com/KartikeySepta/agent-undo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KartikeySepta/agent-undo.git"
  },
  "bugs": {
    "url": "https://github.com/KartikeySepta/agent-undo/issues"
  }
}
