{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node \"AGENT_UNDO_DIR/bin/hook-session-start.cjs\" --platform cursor",
        "timeout": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node \"AGENT_UNDO_DIR/bin/hook-prompt.cjs\" --platform cursor",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": "node \"AGENT_UNDO_DIR/bin/hook-pretooluse.cjs\" --platform cursor",
        "matcher": "Shell",
        "timeout": 60
      }
    ]
  }
}
